# Server Configuration
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Database Configuration (PostgreSQL 17)
DATABASE_URL=postgresql://postgres@localhost:5432/subguard_dev?schema=public
TEST_DATABASE_URL=postgresql://postgres@localhost:5432/subguard_test?schema=public

# Session Security
SESSION_SECRET=subguard-development-session-secret-at-least-32-chars-long
SESSION_MAX_AGE_DAYS=30

# Web Application
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
COOKIE_DOMAIN=localhost

# Optional Background Queue / Redis (fallback to in-memory scheduler if not configured)
REDIS_URL=redis://localhost:6379

# Optional Email Alerts (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SubGuard <alerts@subguard.local>
