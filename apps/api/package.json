    "@prisma/client": "^6.4.1",
    "@subguard/types": "workspace:*",
    "@subguard/utils": "workspace:*",
    "@subguard/validation": "workspace:*",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "csv-parse": "^5.6.0",
    "helmet": "^8.0.0",
